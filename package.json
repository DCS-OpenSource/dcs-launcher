{
  "name": "dcs-launcher",
  "displayName": "DCS Launcher",
  "description": "Launch DCS missions directly from VS Code, skipping the menu. Ideal for rapid EFM development.",
  "version": "1.3.0",
  "publisher": "DCS-OpenSource",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DCS-OpenSource/dcs-launcher.git"
  },
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:dcsLauncher.missions",
    "onView:dcsLauncher.models",
    "onCommand:dcsLauncher.launchMission",
    "onCommand:dcsLauncher.launchModelViewerFile",
    "onCommand:dcsLauncher.launchLastMission",
    "onCommand:dcsLauncher.launchMulticrew",
    "onCommand:dcsLauncher.selectDcsExe",
    "onCommand:dcsLauncher.selectModelViewerExe",
    "onCommand:dcsLauncher.launchModelViewer",
    "onCommand:dcsLauncher.addModel",
    "onCommand:dcsLauncher.addMission"
  ],

  "main": "./dist/extension.js",

  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dcsLauncher",
          "title": "DCS Launcher",
          "icon": "media/dcs.svg"
        }
      ]
    },

    "views": {
      "dcsLauncher": [
        {
          "id": "dcsLauncher.controls",
          "name": "Controls",
          "type": "webview"
        },
        {
          "id": "dcsLauncher.missions",
          "name": "Missions"
        },
        {
          "id": "dcsLauncher.models",
          "name": "Models"
        }
      ]
    },

    "commands": [
      {
        "command": "dcsLauncher.launchMission",
        "title": "DCS Launcher: Launch Mission"
      },
      {
        "command": "dcsLauncher.launchModelViewerFile",
        "title": "DCS Launcher: Launch ModelViewer File"
      },
      {
        "command": "dcsLauncher.selectDcsExe",
        "title": "DCS Launcher: Select DCS Executable"
      },
      {
        "command": "dcsLauncher.selectModelViewerExe",
        "title": "DCS Launcher: Select ModelViewer Executable"
      },
      {
        "command": "dcsLauncher.launchModelViewer",
        "title": "DCS Launcher: Launch ModelViewer"
      },
      {
        "command": "dcsLauncher.launchLastMission",
        "title": "DCS Launcher: Launch Last Mission"
      },
      {
        "command": "dcsLauncher.launchMulticrew",
        "title": "DCS Launcher: Launch DCS Multicrew"
      },
      {
        "command": "dcsLauncher.addMission",
        "title": "DCS Launcher: Add Mission"
      },
      {
        "command": "dcsLauncher.addModel",
        "title": "DCS Launcher: Add .edm / .lods"
      },
      {
        "command": "dcsLauncher.killDcs",
        "title": "DCS Launcher: Kill DCS",
        "icon": "$(debug-stop)"
      }

    ],

    "keybindings": [
      {
        "command": "dcsLauncher.launchLastMission",
        "key": "f8",
        "when": "editorTextFocus"
      }
    ],


    "configuration": {
      "title": "DCS Launcher",
      "properties": {
        "dcsLauncher.dcsExePath": {
          "type": "string",
          "default": "",
          "description": "Full path to DCS.exe (bin-mt recommended)",
          "scope": "application"
        },
        "dcsLauncher.modelViewerExePath": {
          "type": "string",
          "default": "",
          "description": "Full path to modelviewer2.exe",
          "scope": "application"
        },
        "dcsLauncher.missions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of DCS mission files (.miz) for this workspace",
          "scope": "resource"
        },
        "dcsLauncher.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of DCS model files (.edm and .lods) for this workspace",
          "scope": "resource"
        }
      }
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },

  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
